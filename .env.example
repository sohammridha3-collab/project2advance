# ============================================================
# AI-Based Health Risk Prediction System - Environment Config
# ============================================================

# Database Configuration:
# For local SQLite development (default):
DATABASE_URL=sqlite:///./health_risk.db

# For PostgreSQL production / development:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/health_risk_db

# Security & Authentication (JWT):
JWT_SECRET=replace_with_a_secure_random_secret_key_in_production
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (comma-separated):
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# File Upload Directory:
UPLOAD_DIRECTORY=uploads/prescriptions
